<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FAFAFA">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- TOP status row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp"
                android:padding="12dp"
                android:background="#EEEEEE">

                <TextView
                    android:id="@+id/lastTryText"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:typeface="monospace"
                    android:textSize="16sp"
                    android:textColor="#000000"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text=""/>

                <TextView
                    android:id="@+id/lastTryMark"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:gravity="end|center_vertical"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:text=""/>
            </LinearLayout>

            <!-- Row 1: Artnr (61dp) with INSIDE undo button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="70dp"
                    android:layout_height="61dp"
                    android:gravity="center_vertical"
                    android:text="Artnr"
                    android:textSize="18sp"
                    android:layout_marginEnd="8dp"/>

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="61dp">

                    <EditText
                        android:id="@+id/inputField"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:hint="Artikel einscannen"
                        android:textColor="#000000"
                        android:background="@android:drawable/editbox_background"
                        android:inputType="text"
                        android:importantForAutofill="no"
                        android:paddingStart="16dp"
                        android:paddingTop="16dp"
                        android:paddingBottom="16dp"
                        android:paddingEnd="56dp"
                        android:textSize="20sp"
                        android:imeOptions="actionDone"/>

                    <ImageButton
                        android:id="@+id/clearIconButton"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_icon_button"
                        android:contentDescription="Neueingabe"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_undo"
                        android:padding="8dp"/>
                </FrameLayout>
            </LinearLayout>

            <!-- Row 2: Name + Einh. combined (Name first, Einh. at right) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <!-- Two-line label: Name / Einh. -->
                <TextView
                    android:layout_width="70dp"
                    android:layout_height="72dp"
                    android:gravity="center_vertical"
                    android:text="Name&#10;Einh."
                    android:textSize="18sp"
                    android:layout_marginEnd="8dp"/>

                <!-- Name field takes most of the row -->
                <EditText
                    android:id="@+id/nameField"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:minHeight="72dp"
                    android:inputType="textMultiLine|textNoSuggestions"
                    android:singleLine="false"
                    android:maxLines="3"
                    android:background="#EEEEEE"
                    android:padding="16dp"
                    android:textSize="20sp"
                    android:textColor="#444444"
                    android:focusable="false"
                    android:cursorVisible="false"
                    android:longClickable="false"
                    android:clickable="false"
                    android:layout_marginEnd="8dp"/>

                <!-- Small Einheit field on the RIGHT -->
                <EditText
                    android:id="@+id/meField"
                    android:layout_width="56dp"
                    android:layout_height="72dp"
                    android:background="#EEEEEE"
                    android:padding="12dp"
                    android:textSize="20sp"
                    android:textColor="#444444"
                    android:gravity="center"
                    android:inputType="textNoSuggestions"
                    android:importantForAutofill="no"
                    android:focusable="false"
                    android:cursorVisible="false"
                    android:longClickable="false"
                    android:clickable="false"/>
            </LinearLayout>

            <!-- Row 4: von (61dp) with double spacing below -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="32dp">

                <TextView
                    android:layout_width="70dp"
                    android:layout_height="61dp"
                    android:gravity="center_vertical"
                    android:text="von"
                    android:textSize="18sp"
                    android:layout_marginEnd="8dp"/>

                <Spinner
                    android:id="@+id/lagerSpinner"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="61dp"
                    android:background="#EEEEEE"
                    android:padding="8dp"
                    android:popupBackground="#BFE3FF" />
            </LinearLayout>

            <!-- Hint above NACH field (aligned with field start) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="groß-klein-Schreibung ist egal"
                android:textSize="16sp"
                android:textColor="#666666"
                android:layout_marginStart="78dp"
                android:layout_marginBottom="6dp" />

            <!-- Row 5: nach (61dp) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="70dp"
                    android:layout_height="61dp"
                    android:gravity="center_vertical"
                    android:text="nach"
                    android:textSize="18sp"
                    android:layout_marginEnd="8dp"/>

                <EditText
                    android:id="@+id/bestandField"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="61dp"
                    android:background="@android:drawable/editbox_background"
                    android:padding="16dp"
                    android:textSize="20sp"
                    android:textColor="#000000"
                    android:importantForAutofill="no"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:inputType="text"
                    android:imeOptions="actionNext"/>
            </LinearLayout>

            <!-- Row 6: Menge (61dp) with play button INSIDE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="70dp"
                    android:layout_height="61dp"
                    android:gravity="center_vertical"
                    android:text="Menge"
                    android:textSize="18sp"
                    android:layout_marginEnd="8dp"/>

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="61dp">

                    <EditText
                        android:id="@+id/menge"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:drawable/editbox_background"
                        android:paddingStart="16dp"
                        android:paddingTop="16dp"
                        android:paddingBottom="16dp"
                        android:paddingEnd="56dp"
                        android:textSize="20sp"
                        android:textColor="#000000"
                        android:importantForAutofill="no"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:inputType="numberDecimal"
                        android:imeOptions="actionDone"/>

                    <ImageButton
                        android:id="@+id/playButton"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_icon_button"
                        android:contentDescription="Umbuchung"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_play"
                        android:padding="8dp"/>
                </FrameLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
